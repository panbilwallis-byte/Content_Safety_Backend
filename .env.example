# 数据库账号：请使用云端创建的 content_user，不要使用 root。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=content_user
MYSQL_PASSWORD=请填写数据库密码
MYSQL_DATABASE=content_safety

# 设定下列 SSH 配置后，后端会自动通过 SSH 隧道连接 MySQL。
# BitaHub 的 SSH 端口可能会在开发机停止/启动后变化，请以 FinalShell 当前显示为准。
SSH_HOST=xj-member.bitahub.com
SSH_PORT=42243
SSH_USER=root
SSH_PASSWORD=请填写SSH登录密码

# 必填：从已信任的服务器下载 /etc/ssh/ssh_host_ed25519_key.pub 后保存到本机。
# Windows 中可直接使用系统用户目录，不需要填写具体用户名。
SSH_HOST_KEY_FILE=%USERPROFILE%/.ssh/bitahub_ed25519.pub

# 若使用私钥登录，请填写私钥路径，并删除 SSH_PASSWORD；私钥有口令时再填写下一项。
# SSH_PRIVATE_KEY_FILE=C:/Users/your-name/.ssh/id_ed25519
# SSH_PRIVATE_KEY_PASSPHRASE=
